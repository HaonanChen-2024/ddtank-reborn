{
  "name": "ddtank-reborn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:workshop": "pnpm -r --filter \"!launcher\" typecheck",
    "test": "pnpm -r test",
    "dev:all": "node scripts/dev.mjs",
    "free-ports": "bash scripts/free-ports.sh",
    "client:art": "node tools/i18n/build-client-art.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}

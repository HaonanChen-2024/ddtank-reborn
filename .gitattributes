# binary tracking — anything heavy goes to Git LFS
*.swf filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.traineddata filter=lfs diff=lfs merge=lfs -text
*.traineddata.gz filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.msi filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.bak filter=lfs diff=lfs merge=lfs -text
*.mdf filter=lfs diff=lfs merge=lfs -text
*.ldf filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
apps/web/public/fonts/*.otf filter=lfs diff=lfs merge=lfs -text
# Pinned local startup definitions retain exact bytes across autocrlf checkouts.
config/workshop/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Overlay source pins include their original CRLF bytes.
apps/api/assets/flash/ui/vietnam/language.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
research/i18n/zh-CN-overrides.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# History archives retain exact original bytes, including CRLF and old whitespace.
docs/archive/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

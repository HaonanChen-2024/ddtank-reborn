# Copy to .env.workshop. Paths are relative to the repository root.
# Keep this private deployment file out of Git. Supply random independent secrets.
FLASH_DIR=vendor/DDTank41/Source Flash/FlashSV1
FLASH_OVERLAY_DIR=../../runtime/client-overlay
RESOURCE_DIR=vendor/_assets/merged
RUFFLE_DIR=apps/client-harness/public/ruffle
UPLOAD_DIR=../../runtime/uploads
RSA_PRIVATE_KEY_FILE=../../runtime/credentials/RSAKeyValue.xml
JWT_SECRET=
ADMIN_TOKEN=
PG_PASSWORD=
RSA_USE_VENDOR_KEY=false
DEV_ALLOW_ANY_TICKET=false
PG_SEED_DEV_ACCOUNTS=false
LOG_LEVEL=warn
TZ=UTC
# Optional private manifest; upgrades the owned original DB after readiness, before API/game.
# Requires the existing FIGHT_WEAPON_EXTENSION and six deployed original visual assets to match its pins.
